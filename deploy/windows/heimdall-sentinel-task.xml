<?xml version="1.0" encoding="UTF-8"?>
<!--
  Heimdall Sentinel as a Windows scheduled task.

  The task runs at boot, before anyone logs on, as the account named in the
  Principal element. The install script substitutes a real account; the
  placeholder here is deliberately not a working name.

  The isolation posture on Windows is thinner than on Linux and says so.
  A scheduled task is not a sandbox: the daemon gets the rights of the
  account it runs as, and nothing more. The account below is therefore
  meant to be a local account with no administrator rights, used for
  nothing else. Containment stays advisory unless it is explicitly
  enabled, because suspending a process that belongs to another account
  needs rights this task does not grant.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Heimdall Sentinel: host and network defence daemon.</Description>
    <URI>\Heimdall\Sentinel</URI>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <Enabled>true</Enabled>
      <Delay>PT1M</Delay>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="heimdall-sentinel" userId="HEIMDALL_USER">
      <!-- S4U: the task runs whether or not anyone is logged on, and the
           password is not stored on the machine. It needs the "log on as a
           batch job" right, which the installer grants. -->
      <LogonType>S4U</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>5</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="heimdall-sentinel">
    <Exec>
      <Command>C:\Program Files\Heimdall\heimdall-sentinel.exe</Command>
      <Arguments>--endpoint heimdall-sentinel</Arguments>
      <WorkingDirectory>C:\ProgramData\Heimdall</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
